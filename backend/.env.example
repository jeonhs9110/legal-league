# Legal League — backend pipeline secrets
#
# Copy this file to backend/.env and fill in the values you have. Everything
# here is optional: the collectors and the clustering pass run with no keys at
# all. Only the synthesis step (writer -> critic -> refiner) needs a model key.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored. Never commit it, and never paste a real key into
# a chat window or an issue.

# ---------------------------------------------------------------------------
# Language model — needed only for `synthesize.py --write`
# ---------------------------------------------------------------------------
# Used for: plain-language article summaries, firm-to-article entity matching,
# and the writer/critic/refiner chain that turns a cluster into a brief.

# OpenAI (what VaccineDailyReport used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (what backend/pipelines/news/synthesize.py currently calls)
ANTHROPIC_API_KEY=

# Which provider the pipeline should use: openai | anthropic
LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# Supabase — needed only once the pipeline writes to Postgres instead of JSON
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It belongs on this
# machine and in GCP Secret Manager, and nowhere else — never in the frontend,
# never in a NEXT_PUBLIC_ variable, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Collector identity
# ---------------------------------------------------------------------------
# Sent as the User-Agent on every request. Publishers use it to identify and,
# if they choose, to contact or block us — which is the point.
BOT_USER_AGENT=LegalLeagueBot/0.1 (+https://legalleague.org/about)
BOT_CONTACT_EMAIL=editor@legalleague.org
